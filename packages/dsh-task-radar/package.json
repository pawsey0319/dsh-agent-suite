{
  "name": "@pawsey/dsh-task-radar",
  "version": "0.5.0",
  "type": "module",
  "description": "Desktop floating radar for DSH — native AppKit capsule showing running sessions, approvals, finished tasks and office artifacts.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "native/RadarHUD",
    "native/build.sh",
    "native/README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "author": "pawsey0319",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawsey0319/dsh-agent-suite.git",
    "directory": "packages/dsh-task-radar"
  },
  "homepage": "https://github.com/pawsey0319/dsh-agent-suite#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "codex",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ]
}
