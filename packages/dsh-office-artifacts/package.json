{
  "name": "@local/dsh-office-artifacts",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "把工作区里新生成的办公产物（docx/xlsx/pptx/pdf）汇总成清单，供 HUD 与对话使用",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}